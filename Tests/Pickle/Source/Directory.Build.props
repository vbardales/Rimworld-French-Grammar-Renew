<Project>

  <PropertyGroup>
    <!-- Intermediates stay out of the test mod folder, as they do for the shipped mod: the
         staging copies Tests/Pickle/Mod verbatim, and an obj/ inside it would travel with it. -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
